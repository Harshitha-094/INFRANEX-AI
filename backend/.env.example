# INFRANEX AI — Backend Environment Configuration Example
PROJECT_NAME="INFRANEX AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="infranex-civic-intelligence-secure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for local zero-dependency verification, can be set to PostgreSQL + PostGIS)
DATABASE_URL="sqlite:///./infranex.db"
# DATABASE_URL="postgresql://infranex_user:infranex_pass@localhost:5432/infranex_db"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Optional AI / Computer Vision Model Path
# Set to local path of YOLO/PyTorch weights if available, otherwise runs in documented unconfigured/demo mode
AI_MODEL_WEIGHTS_PATH=""
